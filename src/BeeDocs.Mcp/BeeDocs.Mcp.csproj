<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <RootNamespace>BeeDocs.Mcp</RootNamespace>
    <AssemblyName>BeeDocs.Mcp</AssemblyName>
    <Description>BeeDocs MCP server — exposes books, pages, chapters, and diagrams to AI agents</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Studio shape catalog, generated by src/beedocs-web/scripts/gen-diagram-catalog.mjs -->
    <EmbeddedResource Include="diagram-catalog.json" LogicalName="BeeDocs.Mcp.diagram-catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
  </ItemGroup>

</Project>
