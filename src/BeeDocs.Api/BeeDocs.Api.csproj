<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Single source of truth for the container image tag (scripts/deploy-k3s.sh). -->
    <Version>0.7.9</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
    <!-- data/ is the runtime state directory (SQLite, uploads, git clones).
         A cloned repo can contain .cs files, which the SDK's default globs
         would otherwise compile into the API itself. -->
    <Compile Remove="data/**" />
    <Content Remove="data/**" />
    <None Remove="data/**" />
    <EmbeddedResource Remove="data/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.75.0.4218" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
    <!-- Text extraction from uploaded PDFs, so an attachment is searchable by
         what it says. Apache-2.0, pure managed, no transitive dependencies on
         net9.0+. Every other document format the extractor handles is zip+XML,
         which the BCL already covers. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

</Project>
