[package]
name = "{{crate_name}}"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
fframes = { version = "={{fframes_version}}", features = ["cli"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"

# Codec features link a static ffmpeg (prebuilt or compiled); Windows links a prebuilt ffmpeg DLL.
[target.'cfg(not(windows))'.dependencies]
fframes = { version = "={{fframes_version}}", features = ["h264", "libav-agree-gpl"] }

[lib]
name = "{{lib_name}}"
path = "src/lib.rs"
doctest = false

[[bin]]
name = "{{crate_name}}"
path = "src/main.rs"

[workspace]

[profile.dev]
opt-level = 1

[profile.dev.package."*"]
opt-level = 3
